{
  "name": "Typa（タイパ） タイピングれんしゅう",
  "short_name": "Typa",
  "description": "小学生の Chromebook のための タイピング学習アプリ。どの指で どのキーを 押すかを 見ながら、ローマ字入力と ショートカットキーを 練習できます。",
  "lang": "ja",
  "dir": "ltr",
  "categories": ["education"],
  "start_url": "./",
  "scope": "./",
  "id": "/Typa/",
  "display": "standalone",
